  readmeDoc: "\u5FEB\u901F\u4E0A\u624B\uFF1A\n1. \u628A PSD \u653E\u8FDB Unity \u5DE5\u7A0B\u3002\n2.
    \u9009\u4E2D PSD \u6587\u4EF6\uFF0C\u53F3\u952E\u6267\u884C\u201CPsd2UIForm Editor\u201D\uFF0C\u5148\u89E3\u6790\u6210\u8282\u70B9\u6811\u3002\n3.
    \u6253\u5F00\u89E3\u6790\u540E\u7684\u754C\u9762\uFF0C\u68C0\u67E5 UI \u7C7B\u578B\u3001\u52FE\u9009\u9700\u8981\u5BFC\u51FA\u7684\u56FE\u7247\uFF0C\u518D\u70B9\u51FB\u201C\u5BFC\u51FAImages\u201D\u6216\u201C\u751F\u6210UIForm\u201D\u3002\n\n\u547D\u540D\u89C4\u5219\uFF1A\n-
    \u5728\u56FE\u5C42\u6216\u7EC4\u540D\u672B\u5C3E\u52A0\u201C.\u7C7B\u578B\u6807\u7B7E\u201D\u5373\u53EF\u6307\u5B9A
    UI \u7C7B\u578B\uFF0C\u4F8B\u5982\uFF1APlay.btn\u3001Title.text\u3001Avatar.img\u3002\n-
    \u7EC4\u5408\u63A7\u4EF6\u8BF7\u7528\u7EC4\u4F5C\u4E3A\u7236\u8282\u70B9\uFF0C\u5728\u7EC4\u540D\u4E0A\u6807\u4E3B\u7C7B\u578B\uFF0C\u5728\u5B50\u56FE\u5C42\u4E0A\u6807\u5B50\u7C7B\u578B\u3002\u4F8B\u5982\uFF1ALogin.btn
    \u7EC4\u5185\u53EF\u653E Background\u3001Button_Text\u3002\n- \u5982\u679C\u4E0D\u5199\u7C7B\u578B\u6807\u7B7E\uFF0C\u63D2\u4EF6\u4F1A\u81EA\u52A8\u5224\u65AD\uFF1A\u6587\u672C\u56FE\u5C42\u6309\u6587\u672C\uFF0C\u7EAF\u8272\u586B\u5145\u5C42\u6309\u7EAF\u8272\uFF0C\u666E\u901A\u56FE\u7247\u6309\u9ED8\u8BA4\u56FE\u7247\u7C7B\u578B\u3002\n\n\u8BBE\u8BA1\u5EFA\u8BAE\uFF1A\n-
    \u6587\u6848\u5C3D\u91CF\u4F7F\u7528\u771F\u6B63\u7684 PSD \u6587\u672C\u56FE\u5C42\uFF0C\u8FD9\u6837\u624D\u80FD\u8FD8\u539F\u6587\u5B57\u5185\u5BB9\u3001\u5B57\u53F7\u3001\u989C\u8272\u548C\u5927\u90E8\u5206\u6587\u5B57\u6548\u679C\u3002\n-
    \u827A\u672F\u5B57\u3001\u4F4D\u56FE\u5B57\u3001\u505A\u6B7B\u7684\u7279\u6548\u5B57\u8BF7\u5F53\u4F5C
    Image\uFF0C\u4E0D\u8981\u6807\u6210 Text\u3002\n- \u53EF\u62C9\u4F38\u80CC\u666F\u5EFA\u8BAE\u4FDD\u7559\u5B8C\u6574\u8FB9\u6846\uFF0C\u5BFC\u51FA\u65F6\u4F1A\u6309\u4E5D\u5BAB\u683C\u89C4\u5219\u81EA\u52A8\u8BC6\u522B\u3002\n-
    \u7EAF\u8272\u77E9\u5F62\u4F18\u5148\u6807\u6210 FillColor\uFF0CUnity \u4F1A\u76F4\u63A5\u7528\u989C\u8272\u8FD8\u539F\uFF0C\u901A\u5E38\u4E0D\u5FC5\u5355\u72EC\u5BFC\u51FA\u56FE\u7247\u3002\n\n\u590D\u7528\u529F\u80FD\uFF1A\n-
    \u56FE\u5C42\u540D\u4EE5\u201Cref \u8DEF\u5F84\u540D\u201D\u5F00\u5934\u65F6\uFF0C\u4F1A\u590D\u7528\u5171\u4EAB\u56FE\u7247\u8D44\u6E90\uFF0C\u4E0D\u518D\u91CD\u590D\u5BFC\u51FA\u3002\n-
    \u7EC4\u540D\u4EE5\u201Crefp \u8DEF\u5F84\u540D\u201D\u5F00\u5934\u65F6\uFF0C\u4F1A\u590D\u7528\u5171\u4EAB
    Prefab\u3002\n- \u590D\u7528\u8D44\u6E90\u4FDD\u5B58\u4F4D\u7F6E\u7531\u201C\u590D\u7528\u56FE\u7247\u5BFC\u51FA\u8DEF\u5F84\u201D\u548C\u201C\u590D\u7528prefab\u5BFC\u51FA\u8DEF\u5F84\u201D\u51B3\u5B9A\u3002\n\n\u5176\u4ED6\u8BF4\u660E\uFF1A\n-
    \u5F00\u542F\u201C\u5F3A\u5236\u4F18\u5148\u4F7F\u7528TMP\u201D\u540E\uFF0CText\u3001Button\u3001Dropdown\u3001InputField\u3001Toggle
    \u4F1A\u4F18\u5148\u751F\u6210 TMP \u7248\u672C\u3002\n- \u5F00\u542F\u201C\u4E2D\u6587\u8F6C\u62FC\u97F3\u201D\u540E\uFF0C\u5BFC\u51FA\u7684\u5BF9\u8C61\u540D\u548C\u8D44\u6E90\u540D\u4F1A\u81EA\u52A8\u8F6C\u6210\u66F4\u5B89\u5168\u7684\u82F1\u6587/\u62FC\u97F3\u683C\u5F0F\u3002"
  convertZh2En: 1
  nineSliceBorderTolerance: 5
  sharedAssetsOutput: Assets\Examples\Common
  sharedPrefabOutput: Assets\Examples\CommonPrefab
  aiProviderConfig:
    provider: 2
    showCliWindow: 1
